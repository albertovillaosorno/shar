{
  // jig-ignore-next-line: canonical schema URL is indivisible
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  // Git exclusions govern ordinary generated state. Explicit infrastructure
  // ignores also prevent glob traversal through source-linked installations
  // that can point back to this repository.
  "gitignore": true,
  "globs": [
    "**/*.{md,mdc}"
  ],
  "ignores": [
    ".cache/**",
    ".dependencies/**",
    ".git/**",
    ".logs/**",
    ".temp/**",
    "target/**"
  ],
  // Generated Unreal MCP descriptions preserve exact upstream schema prose.
  // Three PCG descriptions use the upstream type spelling `Json`; all other
  // Markdown rules and proper-name checks remain active repository-wide.
  "overrides": [
    {
      "filter": [
        "skills/unreal/capabilities/pcg/toolset/add/node.md",
        "skills/unreal/capabilities/pcg/toolset/add/subgraph-node.md",
        "skills/unreal/capabilities/pcg/toolset/update/node.md"
      ],
      "config": {
        "proper-names": false
      },
      "combine": "merge"
    }
  ],
  "config": {
    // Every rule is enabled. Entries below only select one deterministic form
    // or tighten a configurable default; there are zero rule disables.
    "default": true,

    // Heading structure is explicit and strictly hierarchical.
    "heading-increment": true,
    "heading-style": {
      "style": "atx"
    },
    "blanks-around-headings": {
      "lines_above": 1,
      "lines_below": 1
    },
    "heading-start-left": true,
    "no-duplicate-heading": {
      "siblings_only": false
    },
    "single-title": {
      "level": 1
    },
    "first-line-heading": {
      "level": 1
    },
    "no-trailing-punctuation": {
      "punctuation": ".,;:!。，；：！"
    },

    // Every authored Markdown surface obeys the fixed 80-character limit.
    // Headings, tables, and fenced code have no structural bypass.
    "line-length": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false,
      "headings": true,
      "strict": false
    },

    // Lists have one marker vocabulary, one indentation width, one spacing
    // contract, and mandatory surrounding blank lines.
    "ul-style": {
      "style": "dash"
    },
    "ol-prefix": {
      "style": "one"
    },
    "list-indent": true,
    "ul-indent": {
      "indent": 2
    },
    "blanks-around-lists": true,
    "list-marker-space": {
      "ul_single": 1,
      "ol_single": 1,
      "ul_multi": 1,
      "ol_multi": 1
    },

    // Whitespace is byte-stable. Two-space Markdown hard breaks are forbidden;
    // paragraph structure uses explicit blank lines instead.
    "no-trailing-spaces": {
      "br_spaces": 0,
      "strict": true
    },
    "no-hard-tabs": {
      "code_blocks": true
    },
    "no-multiple-blanks": {
      "maximum": 1
    },
    "single-trailing-newline": true,

    // Markdown stays structurally pure: no HTML escape hatch and no ambiguous
    // link syntax.
    "no-inline-html": {
      "allowed_elements": []
    },
    "no-bare-urls": true,
    "no-empty-links": true,
    "no-alt-text": true,
    "no-reversed-links": true,

    // Code blocks have one fenced representation and always declare language.
    "fenced-code-language": true,
    "code-block-style": {
      "style": "fenced"
    },
    "code-fence-style": {
      "style": "backtick"
    },
    "blanks-around-fences": {
      "list_items": true
    },

    // Inline styling has exactly one spelling and no interior padding.
    "emphasis-style": {
      "style": "asterisk"
    },
    "strong-style": {
      "style": "asterisk"
    },
    "no-space-in-emphasis": true,
    "no-space-in-code": true,
    "no-space-in-links": true,

    // Horizontal rules and tables have one byte representation.
    "hr-style": {
      "style": "---"
    },
    "table-pipe-style": {
      "style": "leading_and_trailing"
    },
    "table-column-count": true,

    // References must resolve and must not leave dead definitions behind.
    "link-fragments": true,
    "reference-links-images": true,
    "link-image-reference-definitions": true,

    // Canonical product/tool names are case-sensitive for token stability.
    "proper-names": {
      "names": [
        "Rust",
        "GitHub",
        "Markdown",
        "Cargo",
        "JSON",
        "CI/CD",
        "Clippy",
        "CSpell",
        "Jig"
      ],
      "code_blocks": false
    }
  }
}
