{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US,en-GB",
  "readonly": true,
  "useGitignore": true,
  "enableGlobDot": true,
  "validateDirectives": true,
  "caseSensitive": true,
  "allowCompoundWords": false,
  "minWordLength": 3,
  "usePnP": false,
  "files": [
    "../../**/*.{cpp,cs,h,ini,json,jsonc,md,mdc,py,rs,toml,txt,yml,yaml}"
  ],
  "ignoreRegExpList": [
    "/\\b[0-9a-f]{7,64}\\b/g"
  ],
  "ignoreWords": [],
  "dictionaryDefinitions": [
    {
      "name": "custom-english",
      "path": "./english.txt",
      "addWords": true
    },
    {
      "name": "custom-named-entities",
      "path": "./named-entities.txt",
      "addWords": true
    },
    {
      "name": "custom-technical",
      "path": "./technical.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "custom-english",
    "custom-named-entities",
    "custom-technical"
  ],
  "ignorePaths": [
    "../../.cache/**",
    "../../.dependencies/**",
    "../../.git/**",
    "../../.logs/**",
    "../../.temp/**",
    "../../Cargo.lock",
    "../../extracted/**",
    "../../game/**",
    "../../src/unreal/project/composition/uproject/Content/**",
    "../../target/**",
    "../../tests/fixtures/**",
    "../../unreal-staging/**"
  ]
}
